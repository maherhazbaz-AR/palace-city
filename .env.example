# Public address of the WordPress site (no trailing slash). Read at build time.
# Used for the announcement banner, highlights, testimonials and the Contact Form 7 lead form.
# Leave it empty to switch WordPress off and show the built-in content only.
VITE_WP_URL=https://adityarampalacecity.com

# reCAPTCHA v3 site key of the WordPress site (public). The Contact Form 7 form rejects leads without a token.
# The key only works on domains listed for it in the Google reCAPTCHA admin console (add the Vercel/custom domain there).
# Defaults to the WordPress site's key when unset; leave it empty to skip the token.
VITE_RECAPTCHA_SITE_KEY=6LdkjgwuAAAAADY0osR9vAdB8LGI1uaV9IHxyo3Y
